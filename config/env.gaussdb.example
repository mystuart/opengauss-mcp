# GaussDB Environment Configuration Example
# Copy this file to .env and customize the values for your environment

# =============================================================================
# DATABASE CONNECTION SETTINGS
# =============================================================================

# Primary database connection URI
# Format: postgresql://username:password@host:port/database
DATABASE_URI=postgresql://postgres:password@localhost:5432/postgres

# Alternative: Individual connection parameters (if DATABASE_URI is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=postgres

# =============================================================================
# GAUSSDB COMPATIBILITY SETTINGS
# =============================================================================

# GaussDB compatibility mode
# Options: auto (detect automatically), force (always use GaussDB mode), disabled (PostgreSQL only)
GAUSSDB_COMPATIBILITY_MODE=auto

# Path to GaussDB compatibility configuration file
GAUSSDB_CONFIG_PATH=./config/gaussdb_compatibility.yaml

# GaussDB version (optional, will be auto-detected if not specified)
# GAUSSDB_VERSION=8.1.0

# =============================================================================
# BENCHMARK TESTING CONFIGURATION
# =============================================================================

# Enable benchmark testing features
BENCHMARK_ENABLED=true

# Directory to store benchmark results
BENCHMARK_RESULTS_DIR=./benchmark_results

# Sysbench executable path (auto-detect if empty)
SYSBENCH_PATH=/usr/local/bin/sysbench

# TPC-C/HammerDB executable path (auto-detect if empty)
TPCC_PATH=/usr/local/bin/hammerdbcli

# Default benchmark parameters
SYSBENCH_TABLES=4
SYSBENCH_TABLE_SIZE=10000
SYSBENCH_THREADS=4
SYSBENCH_TIME=60

TPCC_WAREHOUSES=1
TPCC_CONNECTIONS=4
TPCC_RAMPUP_TIME=30
TPCC_MEASURE_TIME=60

# =============================================================================
# PERFORMANCE AND CONNECTION SETTINGS
# =============================================================================

# Maximum number of database connections
MAX_CONNECTIONS=100

# Connection timeout in seconds
CONNECTION_TIMEOUT=30

# Maximum number of connection retry attempts
MAX_RETRY_ATTEMPTS=3

# Delay between retry attempts in seconds
RETRY_DELAY=1

# Enable query result caching
QUERY_CACHE_ENABLED=true

# Maximum number of cached queries
MAX_CACHED_QUERIES=1000

# =============================================================================
# LOGGING AND DEBUGGING
# =============================================================================

# Enable debug logging
DEBUG_LOGGING=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (optional)
# LOG_FILE=./logs/gaussdb-mcp.log

# Enable SQL query logging
LOG_SQL_QUERIES=false

# =============================================================================
# MCP SERVER SETTINGS
# =============================================================================

# MCP server transport mode
# Options: stdio, sse
TRANSPORT_MODE=stdio

# SSE server host (only used when TRANSPORT_MODE=sse)
SSE_HOST=0.0.0.0

# SSE server port (only used when TRANSPORT_MODE=sse)
SSE_PORT=8000

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# SSL mode for database connections
# Options: disable, allow, prefer, require, verify-ca, verify-full
SSL_MODE=prefer

# SSL certificate file path (optional)
# SSL_CERT_FILE=./certs/client-cert.pem

# SSL key file path (optional)
# SSL_KEY_FILE=./certs/client-key.pem

# SSL CA file path (optional)
# SSL_CA_FILE=./certs/ca-cert.pem

# =============================================================================
# MONITORING AND METRICS
# =============================================================================

# Enable performance metrics collection
METRICS_ENABLED=false

# Metrics collection interval in seconds
METRICS_INTERVAL=60

# Prometheus metrics endpoint (if enabled)
# METRICS_PORT=9090

# =============================================================================
# DEVELOPMENT AND TESTING
# =============================================================================

# Environment type (development, testing, production)
ENVIRONMENT=development

# Enable test data creation
CREATE_TEST_DATA=false

# Test schema name
TEST_SCHEMA=mcp_test

# =============================================================================
# DOCKER-SPECIFIC SETTINGS
# =============================================================================

# Docker network name (for docker-compose)
DOCKER_NETWORK=gaussdb-network

# Container restart policy
RESTART_POLICY=unless-stopped

# Health check interval in seconds
HEALTHCHECK_INTERVAL=30

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Query execution timeout in seconds
QUERY_TIMEOUT=300

# Enable query plan caching
PLAN_CACHE_ENABLED=true

# Maximum query plan cache size
MAX_PLAN_CACHE_SIZE=500

# Enable automatic index recommendations
AUTO_INDEX_RECOMMENDATIONS=true

# Minimum query execution time for index analysis (milliseconds)
MIN_QUERY_TIME_FOR_ANALYSIS=100

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable advanced query optimization
ENABLE_ADVANCED_OPTIMIZATION=false

# Enable distributed query support (for GaussDB clusters)
ENABLE_DISTRIBUTED_QUERIES=false